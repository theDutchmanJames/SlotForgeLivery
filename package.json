{
  "name": "slotforge-livery",
  "productName": "SlotForge Livery",
  "version": "1.5.0",
  "description": "A local 2D livery studio for your own slotcar templates",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/model.test.cjs tests/storage.test.cjs tests/sqlite-library.test.cjs tests/library-client.test.cjs tests/save-fuzz.test.cjs tests/crash-recovery.test.cjs tests/maintenance.test.cjs tests/update-check.test.cjs tests/update-livery.test.cjs",
    "coverage": "node scripts/coverage.cjs",
    "test:integration": "node scripts/test-integration.cjs",
    "benchmark:library": "node scripts/benchmark-library.cjs",
    "perf:audit": "node scripts/perf-audit.cjs",
    "perf:db": "node scripts/perf-db.cjs",
    "pack": "node scripts/pack.cjs",
    "build:icons": "node scripts/build-icon.cjs",
    "setup:converter": "node scripts/setup-converter.cjs",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build:win": "node scripts/build-desktop.cjs windows",
    "format": "prettier --write renderer src tests scripts",
    "format:check": "prettier --check renderer src tests scripts"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "mupdf": "1.28.1"
  },
  "license": "AGPL-3.0-or-later",
  "author": "theDutchmanJames",
  "homepage": "https://github.com/theDutchmanJames/SlotForgeLivery",
  "repository": {
    "url": "git+https://github.com/theDutchmanJames/SlotForgeLivery.git",
    "type": "git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "productName": "SlotForge Livery",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "theDutchmanJames <thedutchmanjames@gmail.com>",
      "synopsis": "2D slotcar livery studio",
      "artifactName": "SlotForgeLivery-${version}-linux-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "Graphics"
    },
    "extraResources": [
      {
        "filter": [
          "bin/gs",
          "bin/gswin64c.exe",
          "bin/gsdll64.dll",
          "doc/COPYING"
        ],
        "from": "vendor/ghostscript",
        "to": "ghostscript"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "notarize": false,
      "identity": "-",
      "artifactName": "SlotForgeLivery-${version}-mac-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "NOTICE"
    ],
    "appId": "nl.slotforge.livery",
    "directories": {
      "output": "dist/v${version}"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "SlotForgeLivery-${version}-windows-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "SlotForgeLivery-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SlotForge Livery",
      "uninstallDisplayName": "SlotForge Livery",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/mupdf/**/*"
    ]
  }
}
